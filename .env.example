# Server variables below belong in apps/server/.env; VITE_* variables belong in
# apps/web/.env. dotenv and Vite both load .env from their own cwd, so a repo-root
# .env is ignored.

# ---- Server ----
HOST=127.0.0.1
PORT=8787
# SQLite database file (relative to apps/server or absolute)
DATABASE_PATH=./data/llm3d.sqlite
# Comma separated list of allowed CORS origins in dev
CORS_ORIGIN=http://localhost:5173

# ---- Web (Vite) ----
# Base URL used by the web app to reach the API. Leave empty to use the Vite proxy.
VITE_API_BASE=
# WebSocket URL. Leave empty to derive from window.location (proxied).
VITE_WS_BASE=

# ---- Optional provider API keys ----
# Provider profiles are managed from the Settings page and stored in SQLite.
# Keys typed in the UI never leave the server. You may also provide keys here and
# copy them into a profile if you prefer keeping secrets out of the database.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
